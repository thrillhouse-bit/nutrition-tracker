<?xml version="1.0" encoding="UTF-8"?>
<!--
  FuelWatch.entitlements — entitlements for the watchOS APP target.

  App Groups: the ONLY capability here. It lets the watch app and its Widget
  Extension (the complication) share the persisted `PlanSummary` snapshot through
  a common UserDefaults suite. The SAME group id must be enabled on BOTH targets
  and must match `SummaryPersistence.appGroupIdentifier`.
  TODO (developer): replace the placeholder id below with your real App Group id.

  No HealthKit entitlement, ON PURPOSE. In v1 the watch does NOT read HealthKit:
  the iPhone is the HealthKit bridge and computes the plan, and the watch only
  renders the `PlanSummary` it receives over WatchConnectivity. Adding HealthKit
  here would claim a capability the watch app never exercises. (WatchConnectivity
  itself needs no entitlement.)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<!-- TODO: your real App Group id (matches SummaryPersistence.appGroupIdentifier). -->
		<string>group.com.example.fuelwatch</string>
	</array>
</dict>
</plist>
