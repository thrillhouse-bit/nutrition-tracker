<?xml version="1.0" encoding="UTF-8"?>
<!--
  FuelCompanion.entitlements — the capabilities this app needs.

  HealthKit + HealthKit background delivery are the only entitlements required
  for the Health bridge. Bundle id and Team are set in the Xcode project's
  signing settings, NOT here.

  NOT present, on purpose:
   • com.apple.developer.healthkit.access — that key is for CLINICAL Health
     Records (medical data). This app reads none, so it is omitted entirely.
   • An App Group — WatchConnectivity does not require one. If the watch target
     later shares a container (e.g. an App Group for cached PlanSummary), add
     com.apple.security.application-groups here with the real group id. It is
     left OUT rather than stubbed, because a placeholder group id would fail
     provisioning. TODO: add it only if/when the watch target needs shared
     storage.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.healthkit</key>
    <true/>
    <key>com.apple.developer.healthkit.background-delivery</key>
    <true/>
</dict>
</plist>
