<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist — the app-specific keys for FuelCompanion. Bundle id, version,
  display name, and the standard launch keys are supplied by the Xcode project
  (authored via a separate XcodeGen spec), so they are intentionally NOT
  duplicated here to avoid two sources of truth.

  NSHealthUpdateUsageDescription is now present (Health/NutritionWriteBack.swift):
  a SEPARATE, opt-in write path for logged nutrition only — dietary
  energy/protein/carbs/fat/fiber/sugar/sodium — never the fueling-signal
  categories above (HealthKitManager still requests `toShare: []` for those;
  see its own header). No clinical Health keys
  (NSHealthClinicalHealthRecordsShareUsageDescription) are present, by
  design — no medical data is read or written.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Body Current</string>

    <!-- Plain-language reason shown in Apple's Health permission sheet. Frames
         the data as fueling context, never medical. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Body Current reads your workouts, active energy, exercise minutes, sleep, and (optionally) heart-rate variability and resting heart rate to explain and time your fueling. This data is read only, sent to your own Body Current dashboard, and never used for medical purposes.</string>

    <!-- Shown only if the user turns on "Sync nutrition to Health" in Settings
         — a separate opt-in, never requested at first launch. -->
    <key>NSHealthUpdateUsageDescription</key>
    <string>Body Current can optionally add the calories and macros you log to Apple Health's Nutrition data, so your food log shows up alongside your other Health data. Off by default — turn it on in the Apple Health tab.</string>

    <!-- Background execution: `fetch` for BGAppRefreshTask, `processing` for the
         longer BGProcessingTask. HealthKit background delivery itself is granted
         by the entitlement, not by a background mode. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>

    <!-- Derived from PRODUCT_BUNDLE_IDENTIFIER, exactly like BackgroundSync,
         so changing the app id cannot silently break task registration. -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER).refresh</string>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER).sync</string>
    </array>

    <!-- App Transport Security: the PWA is expected to be served over HTTPS, so
         no ATS exception is declared (the secure default stands). If you must
         point baseURL at an http:// dev server, add a scoped
         NSAppTransportSecurity → NSExceptionDomains entry here for that host
         only — do NOT set NSAllowsArbitraryLoads. -->
</dict>
</plist>
