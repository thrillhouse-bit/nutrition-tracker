# Copy to .env and fill in. Nothing here is required to run the barcode
# scan → Open Food Facts lookup → log flow — the app boots with sensible
# fallbacks and lights each feature up as you add its key.

# --- Database (optional locally; REQUIRED in production) ------------------
# Neon Postgres connection string. When set, data syncs across devices.
# Local development falls back to server/.data/store.json when this is unset.
# Production refuses to start without durable storage so a deploy cannot
# silently erase accounts, logs, wearable tokens, or legal acceptance records.
# Get one free at https://neon.tech →  run `npm run db:init` once to create tables.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Disposable production previews may opt in explicitly; never set this on a
# real deployment because the JSON file is lost when the container is replaced.
# ALLOW_EPHEMERAL_STORAGE=true

# --- Label OCR (optional) -------------------------------------------------
# Anthropic API key — enables "Scan label" (Claude vision reads the panel).
# https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# Model for label parsing. Defaults to claude-opus-5. For this simple
# extraction, claude-haiku-4-5 or claude-sonnet-5 cost far less per scan.
# ANTHROPIC_MODEL=claude-opus-5

# --- USDA fallback (optional) ---------------------------------------------
# Free FoodData Central key — improves whole-food / produce coverage and adds a
# second barcode source. https://fdc.nal.usda.gov/api-key-signup.html
# FDC_API_KEY=...

# --- Oura wearable (optional) ---------------------------------------------
# Enables the "Energy balance" card (calories in − activity out) on Today.
#
# Preferred: OAuth 2.0 (new tokens require it — PATs were deprecated Dec 2025).
# Register an app at https://cloud.ouraring.com/oauth/applications for a client
# id + secret, set its Redirect URI to <your-app-origin>/api/oura/callback, then
# "Connect Oura" in the Connections tab. Supports multiple connected accounts. See
# the Oura section in the README.
# OURA_CLIENT_ID=...
# OURA_CLIENT_SECRET=...
# OURA_REDIRECT_URI=http://localhost:5173/api/oura/callback
# Production hostname routing (app-only compose + Traefik)
# SITE_ADDRESS=bodycurrent.app
# SITE_ADDRESS_WWW=www.bodycurrent.app
# SITE_ADDRESS_LEGACY=omnifuelapp.tech
# BODY_CURRENT_PUBLIC_URL=https://bodycurrent.app
#
# Legacy: a bearer token for the Oura API v2. An existing PAT still works as a
# single-account fallback; new tokens come from OAuth 2.0 above.
# OURA_TOKEN=...

# --- Garmin wearable (optional) -------------------------------------------
# Push-based "activity out" source for the Energy-balance card (Oura preferred,
# Garmin fallback). Auth is OAuth 2.0 with PKCE; after a user connects, Garmin
# POSTs daily summaries to /api/garmin/webhook and the app serves them from its
# store. Register an app in the Garmin Health API for a client id + secret, set
# its Redirect URI to <your-app-origin>/api/garmin/callback, then "Connect
# Garmin" in the Connections tab. See the Garmin section in the README.
#
# NOTE: the Garmin Connect Developer Program that gates the Health API is
# partner-approval-only and was ON HOLD as of 2026 — you may not be able to get
# credentials yet. Even with credentials, the server fails closed until an
# approved operator has checked the private partner documentation — including
# Garmin's current webhook-origin/signature requirements — and explicitly sets
# GARMIN_INTEGRATION_VERIFIED=true. This flag is an operator acknowledgement,
# not a substitute for implementing whatever verification Garmin requires.
# GARMIN_CLIENT_ID=...
# GARMIN_CLIENT_SECRET=...
# GARMIN_REDIRECT_URI=http://localhost:5173/api/garmin/callback
# GARMIN_INTEGRATION_VERIFIED=false

# --- Apple Health (optional) ----------------------------------------------
# Apple Health has NO cloud API — HealthKit data never leaves the device on its
# own. Instead, a native iOS companion app (or a Health-export importer) POSTs
# normalized samples to /api/apple/ingest, and reads /api/today + /api/entries,
# on YOUR server — every one of those requests carries an `x-ingest-token`
# header identifying which user it belongs to (there's no session cookie; the
# companion has no interactive login). Under multi-user auth there is no
# "endpoint is open" state any more: with no token presented, or one that
# matches no account, every one of those requests 401s.
#
# Preferred: generate a per-user token from the signed-in web app's
# Connections tab (POST /api/apple/token) and paste it into the companion's
# Settings. This variable is a LEGACY single-shared-token fallback only —
# useful before you've generated a per-user one — and it only works while
# exactly one account exists on the box; once a second person signs up it can
# no longer be attributed to anyone and is rejected. Generate a long random
# value and store it with ./set-env.sh APPLE_INGEST_TOKEN.
# APPLE_INGEST_TOKEN=...

# --- Accounts / sessions ---------------------------------------------------
# Signs the session cookie (server/auth.js) — a random secret is generated at
# boot when unset, which is fine for local dev but means every restart signs
# everyone out (the token's signature no longer verifies against a new random
# secret). Set this on any deploy you want sessions to survive a redeploy.
# Generate one with: openssl rand -hex 32
# SESSION_SECRET=...

# Public credential-endpoint abuse limits. Defaults are shown; leave unset for
# one-process deployments. These are process-local, so horizontally scaled
# deployments also need a shared edge/Redis limiter.
# AUTH_LOGIN_CREDENTIAL_MAX=8
# AUTH_LOGIN_IP_MAX=30
# AUTH_LOGIN_WINDOW_MS=900000
# AUTH_SIGNUP_IP_MAX=5
# AUTH_SIGNUP_WINDOW_MS=3600000

# Legal launch gate. New signup and public legal documents require an explicit
# publication review acknowledgement and a meaningful published version. Do not
# set these until the documents are ready to publish. Change LEGAL_VERSION when
# either document materially changes so existing users can be re-consented.
# LEGAL_VERSION=2026-09-04
# LEGAL_REVIEWED=true

# Optional invite-only alpha. When enabled, signup fails closed unless this is
# exactly 10 distinct comma-separated high-entropy codes (24-128 characters;
# letters, numbers, _ and -). Never commit or log real codes; only digests are stored.
# ALPHA_INVITE_ONLY=true
# ALPHA_INVITE_CODES=<code-1>,<code-2>,<code-3>,<code-4>,<code-5>,<code-6>,<code-7>,<code-8>,<code-9>,<code-10>

# --- Server ---------------------------------------------------------------
# PORT=3001
