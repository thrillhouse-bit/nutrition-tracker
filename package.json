{
  "name": "nutrition-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal-use PWA for tracking daily nutrition by scanning barcodes and food labels.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "gen:icons": "node scripts/gen-icons.mjs",
    "db:init": "node server/scripts/init-db.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@neondatabase/serverless": "^0.10.4",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
